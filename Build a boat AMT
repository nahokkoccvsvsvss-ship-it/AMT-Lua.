-- ========== وظيفة Webhook ==========
local function sendToDiscord(title, desc, color)
    local data = {
        ["embeds"] = {{
            ["title"] = title,
            ["description"] = desc,
            ["color"] = color or 16711680,
            ["footer"] = {["text"] = "AMT HUB | " .. os.date("%Y-%m-%d %H:%M:%S")}
        }}
    }
    local body = HttpService:JSONEncode(data)
    pcall(function()
        request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
    end)
end

-- ========== جلب معلومات الحساب ==========
local function getAccountAge(userId)
    local s, r = pcall(function()
        return game:HttpGet("https://users.roblox.com/v1/users/" .. userId)
    end)
    if s then
        local data = HttpService:JSONDecode(r)
        local created = data.created
        local days = math.floor((os.time() - os.time({year=tonumber(created:sub(1,4)), month=tonumber(created:sub(6,7)), day=tonumber(created:sub(9,10))})) / 86400)
        return "🗓 عمر الحساب: " .. days .. " يوم\n📅 تاريخ الإنشاء: " .. created:sub(1,10)
    end
    return "ما قدرنا نجيب عمر الحساب"
end

