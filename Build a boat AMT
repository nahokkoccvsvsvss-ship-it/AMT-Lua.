                    task.wait(2)
                    continue
                end
                
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
                local hrp = char.HumanoidRootPart
                
                for i = 1, 10 do
                    if not getgenv().Farming then break end
                    StatusBar.Text = "📍 " .. i .. "/10"
                    if isArabic then
                        LogText.Text = "🚀 مرحلة " .. i
