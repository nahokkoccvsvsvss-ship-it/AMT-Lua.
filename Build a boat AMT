task.spawn(function()
    local initialGold = -1
    local lastGold = 0
    while task.wait(0.5) do
        local goldStat = (Player:FindFirstChild("leaderstats") and Player.leaderstats:FindFirstChild("Gold")) or
                         (Player:FindFirstChild("Data") and Player.Data:FindFirstChild("Gold")) or
                         (Player:FindFirstChild("stats") and Player.stats:FindFirstChild("Gold"))
        if goldStat then
            local cv = goldStat.Value
            if initialGold == -1 then initialGold = cv lastGold = cv TotalGoldText.Text = "🏦 الإجمالي: " .. cv end
            local earned = cv - initialGold
            TotalGoldText.Text = "🏦 الإجمالي: " .. cv
            EarnedGoldText.Text = "💰 المكتسب: " .. earned
            if goldGoal > 0 and not goalReached and earned >= goldGoal then
                goalReached = true
                ShowGoalEffect()
                EarnedGoldText.Text = "💰 المكتسب: " .. earned .. " ✅"
            end
            if initialGold > 0 then UpdateProgressBar(earned, cv) end
            if cv > lastGold then
                lastGold = cv
                TweenService:Create(TrackerStroke, TweenInfo.new(0.2), {Color = Color3.new(1,1,1)}):Play()
                TweenService:Create(EarnedGoldText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255,220,100), TextSize = 16}):Play()
                task.wait(0.25)
                TweenService:Create(TrackerStroke, TweenInfo.new(0.3), {Color = goalReached and Color3.new(0,1,0) or Color3.fromRGB(255,215,0)}):Play()
                TweenService:Create(EarnedGoldText, TweenInfo.new(0.3), {TextColor3 = goalReached and Color3.new(0,1,0) or Color3.fromRGB(110,255,110), TextSize = 14}):Play()
            end
