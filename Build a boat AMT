local function createPlatform(pos)
    local p = Instance.new("Part", workspace)
    p.Size = Vector3.new(12, 0.5, 12)
    p.Position = pos - Vector3.new(0, 4.5, 0)
    p.Anchored = true
    p.CanCollide = true
    p.BrickColor = BrickColor.new("Bright red")
    p.Material = Enum.Material.Neon
    p.Transparency = 0.4
    game:GetService("Debris"):AddItem(p, 90)
end

local function openChestNOW()
    local target = CFrame.new(-51, -360, 9498)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Position and (obj.Position - target.Position).Magnitude < 50 then
            if obj:FindFirstChild("ClickDetector") then pcall(function() fireclickdetector(obj.ClickDetector) end) end
            if obj:FindFirstChild("ProximityPrompt") then pcall(function() fireproximityprompt(obj.ProximityPrompt) end) end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if getgenv().Farming then
            local char = Player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
            local hrp = char.HumanoidRootPart
            
            for i = 1, 10 do
                if not getgenv().Farming then break end
                StatusBar.Text = "📍 " .. i .. "/10"
                updateLog("🚀 مرحلة " .. i)
                
                local stage = workspace.BoatStages.NormalStages:FindFirstChild("CaveStage" .. i)
                if stage and stage:FindFirstChild("DarknessPart") then
                    createPlatform(stage.DarknessPart.Position)
                    hrp.CFrame = stage.DarknessPart.CFrame + Vector3.new(0, 5, 0)
                end
                task.wait(2.5)
            end
            
            if not getgenv().Farming then break end
            
            StatusBar.Text = "🏆 الكنز"
            updateLog("💛 فتح الكنز...")
            
            local cp = Vector3.new(-51, -360, 9498)
            createPlatform(cp)
            hrp.CFrame = CFrame.new(cp + Vector3.new(0, 3, 0))
            task.wait(0.5)
            openChestNOW()
            
            updateLog("🎉 تم فتح الكنز!")
            game.StarterGui:SetCore("SendNotification", {Title = "🏆 AMT", Text = "تم فتح الكنز!", Duration = 2})
            
            task.wait(12)
            if not getgenv().Farming then break end
            
            if char:FindFirstChild("Humanoid") then char.Humanoid.Health = 0 end
            task.wait(6)
        end
    end
end)

