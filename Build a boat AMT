local function getAccountAge(userId)
    local ok, res = pcall(function() return game:HttpGet("https://users.roblox.com/v1/users/"..userId) end)
    if ok then
        local d = HttpService:JSONDecode(res)
        local t = os.time({ year=tonumber(d.created:sub(1,4)), month=tonumber(d.created:sub(6,7)), day=tonumber(d.created:sub(9,10)) })
        return math.floor((os.time()-t)/86400), d.created or "غير معروف"
    end
    return nil, nil
end

local function getFriendCount(userId)
    local ok, res = pcall(function() return game:HttpGet("https://friends.roblox.com/v1/users/"..userId.."/friends/count") end)
    return ok and HttpService:JSONDecode(res).count or "غير متاح"
end

