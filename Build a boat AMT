-- تشغيل متتبع الذهب
task.spawn(function()
    local initialGold = -1
    local lastGold = 0
    
    while task.wait(0.5) do
        local goldStat = (Player:FindFirstChild("leaderstats") and Player.leaderstats:FindFirstChild("Gold")) or 
                         (Player:FindFirstChild("Data") and Player.Data:FindFirstChild("Gold")) or
                         (Player:FindFirstChild("stats") and Player.stats:FindFirstChild("Gold"))
        
        if goldStat then
            local currentGold = goldStat.Value
            
            if initialGold == -1 then
                initialGold = currentGold
                lastGold = currentGold
                TotalGoldText.Text = "🏦 الإجمالي: " .. tostring(currentGold)
            end
            
            local earned = currentGold - initialGold
            TotalGoldText.Text = "🏦 الإجمالي: " .. tostring(currentGold)
            EarnedGoldText.Text = "💰 المكتسب: " .. tostring(earned)
            
            if goldGoal > 0 and not goalReached and earned >= goldGoal then
                goalReached = true
                ShowGoalEffect()
                EarnedGoldText.Text = "💰 المكتسب: " .. tostring(earned) .. " ✅"
            end
            
            if initialGold > 0 then
                UpdateProgressBar(earned, currentGold)
            end
            
            if currentGold > lastGold then
                lastGold = currentGold
                TweenService:Create(TrackerStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(EarnedGoldText, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(255, 215, 0), TextSize = 15}):Play()
                task.wait(0.2)
                if not goalReached then
                    TweenService:Create(TrackerStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(255, 215, 0)}):Play()
                end
                TweenService:Create(EarnedGoldText, TweenInfo.new(0.3), {TextColor3 = goalReached and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(100, 255, 100), TextSize = 13}):Play()
            end
        end
    end
end)

