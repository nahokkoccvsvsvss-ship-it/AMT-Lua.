local function UpdateProgressBar(current, target)
    local percentage = math.clamp(current / math.max(target, 1), 0, 1)
    if ProgressBarFill then ProgressBarFill:TweenSize(UDim2.new(percentage, 0, 1, 0), "Out", "Quad", 0.3, true) end
end

