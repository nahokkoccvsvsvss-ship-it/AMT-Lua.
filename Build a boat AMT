                else
                    StatusBar.Text = "🏆 Treasure"
                    LogText.Text = "💛 Opening chest..."
                end
                
                local cp = Vector3.new(-51, -360, 9498)
                createPlatform(cp)
                hrp.CFrame = CFrame.new(cp + Vector3.new(0, 3, 0))
                task.wait(0.5)
                openChestNOW()
                
                if isArabic then
                    LogText.Text = "🎉 تم فتح الكنز!"
                else
                    LogText.Text = "🎉 Chest opened!"
                end
                
                task.wait(12)
                if not getgenv().Farming then break end
                
                if char:FindFirstChild("Humanoid") then char.Humanoid.Health = 0 end
                task.wait(6)
            end
        end
    end)
    
