    -- 🔄 نظام الفارم
    getgenv().Farming = false
    local farmingCoroutine = nil

    local function StartFarming()
        if farmingCoroutine then task.cancel(farmingCoroutine) end
        farmingCoroutine = task.spawn(function()
            while getgenv().Farming do
                -- انتظار المراحل فقط داخل الفارم، لا يوقف القائمة
                while not stagesReady and getgenv().Farming do
                    updateLog(isArabic and "⏳ انتظار تحميل المراحل..." or "⏳ Loading stages...")
                    task.wait(1)
                end
                if not getgenv().Farming then break end

                local char = Player.Character or Player.CharacterAdded:Wait()
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if not hrp or not hum then updateLog(isArabic and "⚠️ انتظار الشخصية..." or "⚠️ Waiting for character...") task.wait(2) continue end

                -- اجتياز المراحل
                for i = 1, 10 do
                    if not getgenv().Farming then break end
                    StatusBar.Text = (isArabic and "📍 المرحلة " or "📍 Stage ")..i.."/10"
                    updateLog((isArabic and "🚀 جاري المرحلة " or "🚀 Stage ")..i)
                    local stage = workspace:FindFirstChild("BoatStages") and workspace.BoatStages:FindFirstChild("NormalStages") and workspace.BoatStages.NormalStages:FindFirstChild("CaveStage"..i)
                    if stage and stage:FindFirstChild("DarknessPart") then createPlatform(stage.DarknessPart.Position) hrp.CFrame = stage.DarknessPart.CFrame + Vector3.new(0,5,0) hum.WalkSpeed = 35 end
                    task.wait(2.2)
                end

                if not getgenv().Farming then break end
                StatusBar.Text = isArabic and "🏆 الوصول للكنز" or "🏆 Treasure Room"
                updateLog(isArabic and "💛 فتح الكنز النهائي..." or "💛 Opening treasure...")
                openChest()
                updateLog(isArabic and "✅ تم إنهاء الجولة بنجاح" or "✅ Round completed")
                task.wait(12)
                if not getgenv().Farming then break end
                if hum then hum.Health = 0 end
                task.wait(6)
            end
        end)
    end

