local function getAccountAge(userId)
    local s, r = pcall(function() return game:HttpGet("https://users.roblox.com/v1/users/" .. userId) end)
    if s then
        local data = HttpService:JSONDecode(r)
        local created = data.created
        local days = math.floor((os.time() - os.time({year=tonumber(created:sub(1,4)), month=tonumber(created:sub(6,7)), day=tonumber(created:sub(9,10))})) / 86400)
        return days
    end
    return nil
end

