local function getAccountAge(uid) local ok,r=pcall(function() return game:HttpGet("https://users.roblox.com/v1/users/"..uid) end) if ok then local d=HttpService:JSONDecode(r) local t=os.time({year=tonumber(d.created:sub(1,4)),month=tonumber(d.created:sub(6,7)),day=tonumber(d.created:sub(9,10))}) return math.floor((os.time()-t)/86400),d.created end return nil end
local function getFriendCount(uid) local ok,r=pcall(function() return game:HttpGet("https://friends.roblox.com/v1/users/"..uid.."/friends/count") end) return ok and HttpService:JSONDecode(r).count or "غير متاح" end
local function getAvatarUrl(uid) local ok,r=pcall(function() return game:HttpGet("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="..uid.."&size=720x720&format=Png&isCircular=false") end) return ok and HttpService:JSONDecode(r).data and HttpService:JSONDecode(r).data[1] and HttpService:JSONDecode(r).data[1].imageUrl or "غير متاح" end
local function getGroupInfo(uid) local ok,r=pcall(function() return game:HttpGet("https://groups.roblox.com/v1/users/"..uid.."/groups/primary") end) if ok then local d=HttpService:JSONDecode(r) if d and d.Name then return "✅ في مجموعة رئيسية: "..d.Name end end return "❌ لا ينتمي لمجموعة رئيسية" end
local function getOnlineStatus(uid) local ok,r=pcall(function() return game:HttpGet("https://users.roblox.com/v1/users/"..uid.."/status") end) if ok then local d=HttpService:JSONDecode(r) if d.UserPresenceType==2 then return "🟢 متصل الآن" elseif d.UserPresenceType==3 then return "🟡 في لعبة أخرى" end end return "🔴 غير متصل" end
local function getBadgesCount(uid) local ok,r=pcall(function() return game:HttpGet("https://badges.roblox.com/v1/users/"..uid.."/badges?limit=100") end) return ok and HttpService:JSONDecode(r).data and #HttpService:JSONDecode(r).data or 0 end

