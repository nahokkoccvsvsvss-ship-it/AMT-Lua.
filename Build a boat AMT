local function createPlatform(p) local pt=Instance.new("Part",workspace) pt.Size=Vector3.new(14,0.5,14) pt.Position=p-Vector3.new(0,4.5,0) pt.Anchored=true pt.CanCollide=true pt.BrickColor=BrickColor.new("Bright red") pt.Material=Enum.Material.Neon pt.Transparency=0.4 Debris:AddItem(pt,90) end
