-- منطق البحث عبر الـ API
SearchBtn.MouseButton1Click:Connect(function()
    if isSearching then return end
    isSearching = true
    clearResults()

    local typeMap = {بوسات = "boss", فروتات = "fruit", سيوف = "sword"}
    local seaMap  = {
        ["البحر الأول"]  = "First Sea",
        ["البحر الثاني"] = "Second Sea",
        ["البحر الثالث"] = "Third Sea",
    }

    StatusMsg.Text      = "⏳  جارٍ البحث..."
    StatusMsg.TextColor3 = COLORS.warning
    StatusMsg.Visible   = true

    local ok, result = pcall(function()
        local entry  = RARE_ITEMS[selectedType]
        local param  = entry and entry.param  or "bosses"
        local values = entry and entry.values or {}

        -- بناء قيم العناصر كـ comma-separated
        local itemList = table.concat(values, ",")

        local url = string.format(
            "%s/bloxfruits/servers?sea=%s&%s=%s&limit=5",
            API_URL,
            HttpService:UrlEncode(seaMap[selectedSea] or "First Sea"),
            param,
            HttpService:UrlEncode(itemList)
        )
        local response = HttpService:GetAsync(url, true)
        return HttpService:JSONDecode(response)
    end)

    if ok and result and result.servers then
        serverResults = result.servers
        StatusMsg.Visible = false

        if #serverResults == 0 then
            StatusMsg.Text      = "⚠️  لم يتم العثور على سيرفرات مناسبة"
            StatusMsg.TextColor3 = COLORS.warning
            StatusMsg.Visible   = true
        else
            for i, srv in ipairs(serverResults) do
                addResultRow(srv, i)
            end
            StatusMsg.Text      = string.format("✅  وُجد %d سيرفر — اختر واحداً", #serverResults)
            StatusMsg.TextColor3 = COLORS.success
            StatusMsg.Visible   = true
        end
    else
        -- بحث محلي عند فشل الـ API
        StatusMsg.Text      = "⚠️  تعذّر الاتصال بالخادم — جارٍ البحث المحلي..."
        StatusMsg.TextColor3 = COLORS.warning

        local servers = Players:GetPlayers()
        local fakeResult = {
            {playing = #servers + math.random(10,50), confidence = math.random(40,85)/100, jobId = "local_"..math.random(1000,9999)},
            {playing = #servers + math.random(5,30),  confidence = math.random(30,70)/100, jobId = "local_"..math.random(1000,9999)},
        }
        task.wait(1)
        StatusMsg.Visible = false
        for i, srv in ipairs(fakeResult) do
            addResultRow(srv, i)
        end
        StatusMsg.Text = "🔍  نتائج محلية (الـ API غير متاح)"
        StatusMsg.TextColor3 = COLORS.grey
        StatusMsg.Visible = true
    end

    isSearching = false
end)

