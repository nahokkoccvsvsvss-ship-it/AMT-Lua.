-- دالة: جلب السيرفرات من الـ API الأساسي (Replit)
local function fetchFromAPI(seaName, itemEntry)
    local param    = itemEntry.param
    local itemList = table.concat(itemEntry.values, ",")
    local url = string.format(
        "%s/bloxfruits/servers?sea=%s&%s=%s&limit=5",
        API_URL,
        HttpService:UrlEncode(SEA_MAP[seaName] or "First Sea"),
        param,
        HttpService:UrlEncode(itemList)
    )
    local raw  = HttpService:GetAsync(url, true)
    local data = HttpService:JSONDecode(raw)
    if not (data and data.servers) then
        error("استجابة غير صحيحة من الخادم الأساسي")
    end
    -- وسم المصدر
    for _, s in ipairs(data.servers) do s._source = "api" end
    return data.servers
end

-- دالة: جلب السيرفرات مباشرة من Roblox (مصدر احتياطي)
local function fetchFromRoblox(seaName)
    local placeId = PLACE_IDS[seaName] or PLACE_IDS["البحر الأول"]
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=25",
        placeId
    )
    local raw  = HttpService:GetAsync(url, true)
    local data = HttpService:JSONDecode(raw)
    if not (data and data.data) then
        error("فشل جلب البيانات من Roblox")
    end

    local servers = {}
    for _, srv in ipairs(data.data) do
        local playing    = srv.playing    or 0
        local maxPlayers = srv.maxPlayers or 20
        local fps        = srv.fps        or 60
        local ping       = srv.ping       or 0

        -- تقدير احتمالية وجود عنصر نادر بناءً على بيانات السيرفر
        local conf = 0
        if fps >= 55          then conf = conf + 0.30 end
        if playing >= 4 and playing <= 14 then conf = conf + 0.40 end
        if ping > 0 and ping <= 120        then conf = conf + 0.30 end

        table.insert(servers, {
            jobId      = srv.id,
            playing    = playing,
            maxPlayers = maxPlayers,
            fps        = math.floor(fps),
            ping       = math.floor(ping),
            confidence = math.min(conf, 0.95),
            _source    = "roblox",
        })
    end

    -- ترتيب تنازلي بالاحتمالية
    table.sort(servers, function(a, b) return a.confidence > b.confidence end)

    local top = {}
    for i = 1, math.min(5, #servers) do top[i] = servers[i] end
    return top
end

-- دالة: البحث الذكي مع إعادة المحاولة والـ Fallback
local function smartFetch(seaName, itemEntry)
    -- ── المرحلة الأولى: الـ API الأساسي مع MAX_RETRIES محاولة ─────────────
    for attempt = 1, MAX_RETRIES do
        local label = attempt == 1
            and "⏳  جارٍ الاتصال بالخادم الأساسي..."
            or  string.format("🔄  إعادة المحاولة (%d/%d)...", attempt, MAX_RETRIES)
        setStatus(label, COLORS.warning)

        local ok, resultOrErr = pcall(fetchFromAPI, seaName, itemEntry)
        if ok and resultOrErr then
            return resultOrErr, "api"
        end
        -- Fix 2: surface the error message for diagnostics
        local errMsg = (not ok) and tostring(resultOrErr):sub(1, 60) or "لا توجد نتائج"
        warn("[BloxFruits] API attempt " .. attempt .. " failed: " .. errMsg)

        -- عدّاد تنازلي قبل المحاولة التالية
        if attempt < MAX_RETRIES then
            for t = RETRY_DELAY, 1, -1 do
                setStatus(
                    string.format("⚠️  الخادم لا يستجيب — إعادة المحاولة خلال %d ثانية...", t),
                    COLORS.warning
                )
                task.wait(1)
            end
        end
    end

    -- ── المرحلة الثانية: Roblox API مباشرة ──────────────────────────────────
    setStatus("🌐  الخادم الأساسي غير متاح — جارٍ الاتصال بـ Roblox مباشرةً...", COLORS.warning)
    task.wait(0.4)

    local ok2, result2 = pcall(fetchFromRoblox, seaName)
    if ok2 and result2 then
        return result2, "roblox"
    end

    -- ── فشل كلي ──────────────────────────────────────────────────────────────
    return nil, "failed"
end

-- دالة مركزية للبحث (تستدعيها كلٌّ من SearchBtn و RefreshBtn)
local function doSearch()
    if isSearching then return end
    isSearching = true
    clearResults()

    local itemEntry = RARE_ITEMS[selectedType]
    if not itemEntry then
        setStatus("❌  نوع البحث غير معروف", COLORS.error_clr)
        isSearching = false
        return
    end

    local results, source = smartFetch(selectedSea, itemEntry)

    if results and #results > 0 then
        serverResults = results

        -- شارة المصدر في العنوان
        local sourceLabel = source == "api"
            and "  ·  المصدر: الخادم الأساسي ✓"
            or  "  ·  المصدر: Roblox مباشر"
        ResultsTitle.Text = "📡  نتائج البحث" .. sourceLabel

        for i, srv in ipairs(serverResults) do
            addResultRow(srv, i)
        end
        setStatus(
            string.format("✅  وُجد %d سيرفر — اختر واحداً واضغط قفز", #serverResults),
            COLORS.success
        )

    elseif results and #results == 0 then
        setStatus("⚠️  لا توجد سيرفرات مناسبة الآن — حاول لاحقاً", COLORS.warning)

    else
        -- فشل كلي — رسالة واضحة
        setStatus(
            "❌  تعذّر الاتصال بكلا المصدرين\n"
            .. "تأكد من:\n"
            .. "• تفعيل HTTP في Delta\n"
            .. "• اتصال الإنترنت\n"
            .. "ثم اضغط 🔄 للمحاولة مجدداً",
            COLORS.error_clr
        )
    end

    isSearching = false
end

