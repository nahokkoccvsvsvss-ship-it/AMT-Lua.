    -- زر الاختيار
    local selectBtn = Instance.new("TextButton")
    selectBtn.Text             = "✓ اختر"
    selectBtn.TextSize         = 10
    selectBtn.Font             = Enum.Font.GothamBold
    selectBtn.TextColor3       = COLORS.white
    selectBtn.BackgroundColor3 = COLORS.bg_dark
    selectBtn.Size             = UDim2.new(0, 52, 0, 18)
    selectBtn.Position         = UDim2.new(1, -60, 0, 5)
    selectBtn.AutoButtonColor  = false
    selectBtn.BorderSizePixel  = 0
    selectBtn.Parent           = row
    makeCorner(selectBtn, 5)

    selectBtn.MouseButton1Click:Connect(function()
        selectedServer = server
        for _, child in ipairs(ResultsScroll:GetChildren()) do
            if child:IsA("Frame") then
                tween(child, {BackgroundColor3 = COLORS.bg_light}, 0.1)
