-- دوال مساعدة للـ GUI
-- ─────────────────────────────────────────────────────────────────────────────
local function tween(obj, props, t, style, dir)
    t     = t     or 0.18
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(t, style, dir), props):Play()
end

local function makeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
end

local function makeStroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color     = color or COLORS.divider
    s.Thickness = thickness or 1
    s.Parent    = parent
end

local function makePadding(parent, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, top    or 8)
    p.PaddingBottom = UDim.new(0, bottom or 8)
    p.PaddingLeft   = UDim.new(0, left   or 8)
    p.PaddingRight  = UDim.new(0, right  or 8)
    p.Parent = parent
end

local function makeLabel(parent, text, size, color, xAlign)
    local lbl = Instance.new("TextLabel")
    lbl.Text              = text
    lbl.TextSize          = size  or 14
    lbl.TextColor3        = color or COLORS.white
    lbl.Font              = Enum.Font.GothamBold
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment    = xAlign or Enum.TextXAlignment.Center
    lbl.TextWrapped       = true
    lbl.Size              = UDim2.new(1, 0, 0, size and size + 6 or 22)
    lbl.Parent            = parent
    return lbl
end

local function makeButton(parent, text, bgColor, textColor)
    bgColor   = bgColor   or COLORS.bg_light
    textColor = textColor or COLORS.white

    local btn = Instance.new("TextButton")
    btn.Text              = text
    btn.TextSize          = 13
    btn.TextColor3        = textColor
    btn.Font              = Enum.Font.GothamBold
    btn.BackgroundColor3  = bgColor
    btn.Size              = UDim2.new(1, 0, 0, 34)
    btn.AutoButtonColor   = false
    btn.BorderSizePixel   = 0
    btn.TextWrapped       = true
    btn.Parent            = parent
    makeCorner(btn, 7)
    makeStroke(btn, COLORS.accent, 1)

    -- تأثير hover
    btn.MouseEnter:Connect(function()
        tween(btn, {BackgroundColor3 = COLORS.accent}, 0.15)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, {BackgroundColor3 = bgColor}, 0.15)
    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, {BackgroundColor3 = COLORS.accent_h, Size = UDim2.new(1, -4, 0, 32)}, 0.1)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, {BackgroundColor3 = COLORS.accent, Size = UDim2.new(1, 0, 0, 34)}, 0.15)
    end)

    return btn
end

local function makeScrollFrame(parent, height)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size                 = UDim2.new(1, 0, 0, height or 200)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel      = 0
    scroll.ScrollBarThickness   = 4
    scroll.ScrollBarImageColor3 = COLORS.accent
    scroll.CanvasSize           = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize  = Enum.AutomaticSize.Y
    scroll.Parent               = parent

    local layout = Instance.new("UIListLayout")
    layout.Padding         = UDim.new(0, 6)
    layout.FillDirection   = Enum.FillDirection.Vertical
    layout.SortOrder       = Enum.SortOrder.LayoutOrder
    layout.Parent          = scroll

    return scroll, layout
end

