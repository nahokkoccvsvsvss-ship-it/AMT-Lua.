    -- سطر المعلومات: لاعبين | FPS | Ping | احتمالية
    local fps  = server.fps  and string.format("FPS:%d", server.fps)  or ""
    local ping = server.ping and string.format("Ping:%dms", server.ping) or ""
    local parts = {"لاعبين:" .. (server.playing or 0)}
    if fps  ~= "" then table.insert(parts, fps)  end
    if ping ~= "" then table.insert(parts, ping) end
    table.insert(parts, string.format("احتمالية:%d%%", pct))

    local infoLbl = makeLabel(row, table.concat(parts, "  ·  "), 10, COLORS.grey_light, Enum.TextXAlignment.Right)
    infoLbl.Position = UDim2.new(0, 0, 0, 4)
