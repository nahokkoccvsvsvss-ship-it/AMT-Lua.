-- زر توليد المفتاح
GenerateBtn.MouseButton1Click:Connect(function()
    GenerateBtn.Text = "⏳ جاري السحب..."
    task.wait(0.8)
    
    math.randomseed(os.time())
    local chance = math.random(1, 100)
    local targetChance = (isFriend or LocalPlayer.Name == OwnerName or LocalPlayer.Name == CoOwnerName) and 99 or 15
    
    if chance <= targetChance then
        local rolledKey = KeysList[math.random(1, #KeysList)]
        KeyInput.Text = rolledKey
        GenerateBtn.Text = "✅ نجح السحب!"
        GenerateBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        if setclipboard then setclipboard(rolledKey) end
    else
        KeyInput.Text = ""
        GenerateBtn.Text = "❌ حاول مجدداً"
        GenerateBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    end
    task.wait(1)
    GenerateBtn.Text = "🎲 توليد مفتاح"
    GenerateBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
end)

-- الانتقال للأسئلة
ActivateBtn.MouseButton1Click:Connect(function()
    local enteredKey = string.gsub(KeyInput.Text, "%s+", "")
    local isValid = false
    for _, k in ipairs(KeysList) do if enteredKey == k then isValid = true break end end
    
    if isValid then
        KeyFrame.Visible = false
        QuizFrame.Visible = true
        ProgressLabel.Text = "السؤال: 1 من 4"
        QuestionLabel.Text = Quiz[1].q
        OptABtn.Text = Quiz[1].options[1]
        OptBBtn.Text = Quiz[1].options[2]
    else
        ActivateBtn.Text = "❌ مفتاح خاطئ!"
        ActivateBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.2)
        ActivateBtn.Text = "🚀 الانتقال للأسئلة"
        ActivateBtn.BackgroundColor3 = Color3.fromRGB(130, 0, 255)
    end
end)

-- إجابات الأسئلة
local function HandleQuizAnswer(selectedText)
    local currentQuizData = Quiz[currentQuestion]
    
    if currentQuizData.special == true then
        OptABtn.Visible = false
        OptBBtn.Visible = false
        ProgressLabel.Text = "👑 النتيجة"
        QuestionLabel.Text = "💪 كفو الرجال"
        QuestionLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
        Stroke.Color = Color3.fromRGB(0, 255, 150)
        
        task.wait(2)
        GUI:Destroy()
        LaunchMainScript()
        return
    end
    
    if currentQuizData.ans == "ANY" or selectedText == currentQuizData.ans then
        currentQuestion = currentQuestion + 1
        ProgressLabel.Text = "السؤال: " .. currentQuestion .. " من 4"
        QuestionLabel.Text = Quiz[currentQuestion].q
        OptABtn.Text = Quiz[currentQuestion].options[1]
        OptBBtn.Text = Quiz[currentQuestion].options[2]
    else
        QuestionLabel.Text = "❌ إجابة خاطئة! أعد تشغيل السكربت وحاول مجدداً."
        QuestionLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        OptABtn.Visible = false
        OptBBtn.Visible = false
        task.wait(2.5)
        GUI:Destroy()
    end
end

OptABtn.MouseButton1Click:Connect(function() HandleQuizAnswer(OptABtn.Text) end)
OptBBtn.MouseButton1Click:Connect(function() HandleQuizAnswer(OptBBtn.Text) end)
