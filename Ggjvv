local Quiz = {
    [1] = {q = "من صنع أول سكربت MM2 جدد؟", options = {"Eclipse Hub", "Vynixu Hub"}, ans = "Eclipse Hub", special = false},
    [2] = {q = "سؤال رياضيات: ما هو ناتج 9 × 9 ؟", options = {"81", "72"}, ans = "81", special = false},
    [3] = {q = "هل يوجد أي لاعب في هذا السيرفر يستخدم هاك؟", options = {"نعم أشك بذلك", "لا الكل يلعب نظيف"}, ans = "ANY", special = false},
    [4] = {q = "ايش اسوء عمات بالدنيا؟", options = {"رزان", "نسرين"}, ans = "BOTH", special = true}
}
local currentQuestion = 1

